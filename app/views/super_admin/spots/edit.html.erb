<h1 class="text-3xl text-bold">Spots</h1>

<div class="spot-card bg-orange-200 rounded-lg border border-orange-700 p-4 space-y-6 max-w-5xl mx-auto">
  <!-- 部分テンプレート shared/spot_form を読み込み、@spot を渡してフォームを表示 -->
  <%= render 'shared/spot_form', spot: @spot %>
</div>

<%= render 'shared/google_map', callback_name: 'EditMacker' %>

<script>
  window.MapArgument = window.MapArgument || {};
  MapArgument.map = null;
  MapArgument.marker = null;

  window.EditMacker = function() {
    const mapElement = document.getElementById('map');
    const latLng = { lat: <%= @spot.latitude %>, lng: <%= @spot.longitude %> };

    MapArgument.map = new google.maps.Map(mapElement, {
      zoom: 16,
      center: latLng,
    });

    MapArgument.marker = new google.maps.Marker({
      position: latLng,
      map: MapArgument.map,
      title: "<%= j @spot.name %>"
    });

    const geocoder = new google.maps.Geocoder();

    const input = document.createElement("input");
    input.placeholder = "住所検索";
    input.type = "text";
    input.className = "border p-2 rounded-md shadow mb-2 w-64";
    MapArgument.map.controls[google.maps.ControlPosition.TOP_LEFT].push(input);

    input.addEventListener("change", () => {
      geocodeAddress(geocoder, MapArgument.map, input.value);
    });

    MapArgument.map.addListener("click", (e) => {
      placeMarker(e.latLng);
    });
  }

  function geocodeAddress(geocoder, map, address) {
    geocoder.geocode({ address: address }, (results, status) => {
      if (status === "OK") {
        map.setCenter(results[0].geometry.location);
        placeMarker(results[0].geometry.location);
      } else {
        alert("住所の取得に失敗しました: " + status);
      }
    });
  }

  function placeMarker(location) {
    if (MapArgument.marker) { MapArgument.marker.setMap(null); }

    MapArgument.marker = new google.maps.Marker({
      position: location,
      map: MapArgument.map,
    });

    document.getElementById("latitude").value = location.lat();
    document.getElementById("longitude").value = location.lng();
  }
</script>
